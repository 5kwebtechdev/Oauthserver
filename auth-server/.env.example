# Copy to .env (gitignored) and fill in real values. Loaded automatically at startup
# via spring-dotenv - no shell export or IDE plugin needed.
#
# Gmail SMTP: use an App Password (Google Account -> Security -> 2-Step Verification ->
# App passwords), not your real account password - it's revocable independently and is
# the only kind of password Gmail accepts for SMTP AUTH when 2FA is on.
MAIL_USERNAME=
MAIL_PASSWORD=

# Cloudflare Turnstile secret key (dash.cloudflare.com -> Turnstile). Left empty, captcha
# verification is disabled (not broken) - see TurnstileVerificationService's Javadoc.
# The matching site key is public and goes in FE/src/app/core/app-config.ts instead.
TURNSTILE_SECRET_KEY=

# Allows this server to MODIFY SuperMeBE's live tables (mindfullP1.User and
# mindfullP1.UserPassword). Default false: authentication, token issuance and every read work
# fine without it, so a deployment can be brought up and verified without touching anyone's
# data. Turning it on enables exactly two writes - linking a Google provider id onto an
# existing account, and password resets. That schema is shared with the running SuperMeApp
# backend, so take a dump of those two tables before switching it on.
SUPERME_WRITES_ENABLED=false

# Datasource. Points at SuperMeBE's own schema, because the users this server authenticates
# are the real SuperMeApp accounts - there is no separate user table any more. The URL in
# application.yml appends the database name, so this is the host/port part only.
DB_PRIMARY_URL=
DB_PRIMARY_USERNAME=
DB_PRIMARY_PASSWORD=
