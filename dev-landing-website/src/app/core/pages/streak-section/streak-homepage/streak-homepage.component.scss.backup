:root {
	--bg: #fafafa;
	--card-bg: #fff;
	--muted: #777;
	--accent: #0b75ff;
}

.streak-homepage {
	background: var(--bg);
	min-height: calc(100vh - 96px);
	padding: 28px 20px;

	.page-container {
		display: grid;
		grid-template-columns: 280px 1fr;
		gap: 20px;
		align-items: start;
		max-width: 1200px;
		margin: 0 auto;
	}

	.left-col {
		align-self: start;
		position: sticky;
		top: 28px;
		z-index: 3;
		.section-title { color: #282527;
font-family: Fredoka;
font-size: 25px;
font-style: normal;
font-weight: 500;
line-height: 140%; /* 35px */ margin-bottom: 12px; }

		.stat-list { display: flex; flex-direction: column; gap: 14px; }

		.stat-card {
			background: var(--card-bg);
			border-radius: 12px;
			padding: 18px;
			box-shadow: 0 2px 0 rgba(0,0,0,0.04);
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;

			.stat-title { color: var(--muted); font-size: 13px; margin-bottom: 8px; }
			.stat-icon { font-size: 28px; margin-bottom: 8px; }
			.stat-value { font-weight: 700; font-size: 20px; color: #111; }
		}
	}

	.right-col {
		.leaderboard-card {
			background: var(--card-bg);
			border-radius: 12px;
			padding: 12px 18px 20px 18px;
			box-shadow: 0 6px 18px rgba(0,0,0,0.06);
			position: relative;
			overflow: visible;

			.leaderboard-header { display: flex; align-items: center; justify-content: space-between; padding: 8px 0 12px 0; }
			.title { color: #282527;
font-family: Fredoka;
font-size: 25px;
font-style: normal;
font-weight: 500;
line-height: 140%; /* 35px */ }

			.panda-bubble {
				display:flex; align-items:center; gap:10px; ;
				.bubble-text { color: #282527;
font-family: Nunito;
font-size: 16px;
font-style: normal;
font-weight: 600;
line-height: 150%; /* 24px */
background:#ffdca6; padding:12px; border-radius:12px; box-shadow: 0 4px 10px rgba(0,0,0,0.06) }
				img { width:64px; height:64px; object-fit:contain; }
			}

			/* allow the leaderboard to scroll internally while stats stay visible */
			.leader-list { list-style:none; margin:0; padding:0; }
			max-height: calc(100vh - 220px);
			overflow: auto;
			.leader { display:flex; align-items:center; justify-content:space-between; padding:12px 10px; border-top: 1px solid #f0f0f0; }

			.leader.top { background: #D9EDDA; border-radius: 8px; margin: 6px 0; }


			.leader-left { display:flex; align-items:center; gap:12px; }
			.rank { width:28px; text-align:center; color: #282527;
text-align: center;
font-family: Nunito;
font-size: 25px;
font-style: normal;
font-weight: 600;
line-height: 140%; /* 35px */ }
			.avatar { width:36px; height:36px; border-radius:50%; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,0.06); }
			.avatar img { width:100%; height:100%; object-fit:cover; }
			.name { color: #282527;
text-align: center;
font-family: Nunito;
font-size: 25px;
font-style: normal;
font-weight: 600;
line-height: 140%; /* 35px */ }

			.leader-right { color: #6B656A;
text-align: center;
font-family: Nunito;
font-size: 25px;
font-style: normal;
font-weight: 600;
line-height: 140%; /* 35px */ }
		}
	}
}

@media (max-width: 900px) {
	.streak-homepage .page-container { grid-template-columns: 1fr; }
	.streak-homepage .left-col { order: 2; }
	.streak-homepage .left-col { position: static; top: auto; }
	.streak-homepage .right-col { order: 1; }
	.panda-bubble img { width:48px; height:48px; }
}

/* Loading state */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48px 24px;
  gap: 16px;

  p {
    font-size: 16px;
    color: #666;
    margin: 0;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid #f0f0f0;
    border-top-color: #0b75ff;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* Empty state */
.empty-state {
  text-align: center;
  padding: 32px;
  color: #6b656a;
  font-family: 'Nunito', sans-serif;
}

/* Trend indicators */
.trend {
  width: 14px;
  margin-right: 8px;
}

.triangle {
  display: inline-block;
  width: 0;
  height: 0;
  border-left: 6px solid transparent;
  border-right: 6px solid transparent;
}

.triangle.up {
  border-bottom: 10px solid #33a853;
}

.triangle.down {
  border-top: 10px solid #d23f3f;
}

