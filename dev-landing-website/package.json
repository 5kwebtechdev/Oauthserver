{
  "name": "superme",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --max-old-space-size=4096 ./node_modules/@angular/cli/bin/ng serve",
    "build": "ng build",
    "postbuild": "node scripts/website-routes.mjs --write && node --test scripts/website-server.test.mjs && node scripts/deploy-logged-in-app.mjs && node scripts/activate-website-server.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.4",
    "@angular/common": "^20.3.4",
    "@angular/compiler": "^20.3.4",
    "@angular/core": "^20.3.4",
    "@angular/forms": "^20.3.4",
    "@angular/platform-browser": "^20.3.4",
    "@angular/platform-server": "^20.3.4",
    "@angular/router": "^20.3.4",
    "@angular/ssr": "^20.3.14",
    "@emailjs/browser": "^4.4.1",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@ionic/angular": "^8.7.7",
    "angularx-qrcode": "^20.0.0",
    "bootstrap": "^5.3.8",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "libphonenumber-js": "^1.13.15",
    "rxjs": "~7.8.0",
    "serve-handler": "6.1.7",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.5",
    "@angular/cli": "^20.3.5",
    "@angular/compiler-cli": "^20.3.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "baseline-browser-mapping": "^2.9.11",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2"
  }
}
