{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "app": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "www",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "allowedCommonJsDependencies": [
              "qrcode",
              "@stomp/stompjs",
              "sockjs-client",
              "scriptjs"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets",
                "ignore": [
                  "figma/avatars/11-13-*.webp",
                  "figma/avatars/14-15-*.webp",
                  "figma/avatars/16-17-*.webp",
                  "figma/avatars/below-11-female-*.webp",
                  "figma/avatars/below-11-male-[2-6].webp",
                  "figma/avatars/18-plus-female-*.webp",
                  "figma/avatars/18-plus-male-[2-6].webp",
                  "figma/child-planner/superme-planner-habit.png",
                  "figma/child-planner/superme-planner-tab.png",
                  "figma/child-planner/superme-planner-task.png",
                  "icons/Time-table.svg",
                  "figma/activity-event/tab-calendar.png",
                  "figma/activity-event/tab-task.png",
                  "figma/activity-event/tab-habit.png",
                  "figma/child-activity/tab-all.webp",
                  "figma/child-activity/tab-task.webp",
                  "figma/child-planner/superme-planner-habit.webp",
                  "figma/child-planner/superme-planner-tab.webp",
                  "figma/child-planner/superme-planner-task.webp",
                  "figma/planner-daily/tab-all.webp",
                  "figma/planner-daily/tab-habit.webp",
                  "figma/planner-daily/tab-planner.webp",
                  "figma/planner-daily/tab-task.webp",
                  "Navigation/figma-logged-in/superme-logo.webp",
                  "figma/streak-milestones/broken.webp",
                  "figma/parent-eduhub-inner/header-background.webp",
                  "Images-Thumbnails/Image-Onboarding3.jpg",
                  "Images-Thumbnails/Background-Home.png",
                  "Images-Thumbnails/Image-Onboarding1.jpg",
                  "Images-Transparent/Image-Onboarding-Pet2.png",
                  "Images-Transparent/Image-Onboading-Pet.png",
                  "app-assets/badges/comeback-star-icon.png",
                  "app-assets/badges/habit-master-icon.png",
                  "app-assets/badges/first-big-win-icon.png"
                ]
              },
              {
                "glob": "**/*.svg",
                "input": "node_modules/ionicons/dist/ionicons/svg",
                "output": "./svg"
              },
              {
                "glob": "firebase-messaging-sw.js",
                "input": "src",
                "output": "/"
              }
            ],
            "styles": [
              "src/global.scss",
              "src/theme/variables.scss",
              "node_modules/swiper/swiper-bundle.min.css"
            ],
            "scripts": [
              "node_modules/swiper/swiper-bundle.min.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "32kb",
                  "maximumError": "100kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                },
                {
                  "replace": "src/app/core/services/apple-sign-in.development-mock.ts",
                  "with": "src/app/core/services/apple-sign-in.production-mock.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "ci": {
              "progress": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "host": "0.0.0.0",
            "port": 4200
          },
          "configurations": {
            "production": {
              "buildTarget": "app:build:production"
            },
            "development": {
              "buildTarget": "app:build:development"
            },
            "ci": {
              "progress": false
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "app:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "**/*.svg",
                "input": "node_modules/ionicons/dist/ionicons/svg",
                "output": "./svg"
              }
            ],
            "styles": [
              "src/global.scss",
              "src/theme/variables.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "ci": {
              "progress": false,
              "watch": false
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "@ionic/angular-toolkit"
    ],
    "analytics": false
  },
  "schematics": {
    "@ionic/angular-toolkit:component": {
      "styleext": "scss"
    },
    "@ionic/angular-toolkit:page": {
      "styleext": "scss"
    }
  }
}
