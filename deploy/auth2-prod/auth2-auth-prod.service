[Unit]
Description=Auth2.0 Authorization Server (PROD - authprod.supermeapp.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Auth2.0-prod
EnvironmentFile=/root/Auth2.0-prod/auth.env
ExecStart=/usr/bin/java -jar /root/Auth2.0-prod/current/auth-server.jar --spring.profiles.active=prod
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
