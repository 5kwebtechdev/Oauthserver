# PROD auth.env — only used if /root/Auth2.0-prod/auth.env does not already
# exist on the server. systemd syntax, no export or variable expansion.
SERVER_PORT=9001
AUTH_ISSUER=https://authprod.supermeapp.com
JWT_PRIVATE_KEY_PATH=/root/prod-privateKey.pem
JWT_PUBLIC_KEY_PATH=/root/prod-publicKey.pem
JWT_KEY_ID=CHANGE_ME
AUTH_DB_URL="jdbc:mysql://127.0.0.1:3306/mindfullP1?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8"
DB_PRIMARY_USERNAME=CHANGE_ME
DB_PRIMARY_PASSWORD="CHANGE_ME"

FE_ORIGIN=https://admin.supermeapp.com,https://supermeapp.com
OAUTH_CLIENT_ID=supermeapp-web-prod
OAUTH_REDIRECT_URIS=https://supermeapp.com/callback
OAUTH_POST_LOGOUT_REDIRECT_URI=https://supermeapp.com/
FE_BASE_URL=https://supermeapp.com/
FE_FORGOT_PASSWORD_URL=https://supermeapp.com/forgot-password
FE_CONTINUE_WITH_EMAIL_URL=https://supermeapp.com/continue-with-email

GOOGLE_CLIENT_ID=CHANGE_ME
MAIL_USERNAME=""
MAIL_PASSWORD=""
# Leave false until a real prod frontend is wired to this server and you
# deliberately want Google account registration writes to go live.
SUPERME_WRITES_ENABLED=false

# ---- SuperMeAdmin panel (admin.supermeapp.com) ----
DB_ADMIN_URL="jdbc:mysql://127.0.0.1:3306/mindfullAdmin?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8"
DB_ADMIN_USERNAME=CHANGE_ME
DB_ADMIN_PASSWORD="CHANGE_ME"
ADMIN_OAUTH_CLIENT_ID=supermeadmin-web
ADMIN_OAUTH_REDIRECT_URIS=https://admin.supermeapp.com/callback
ADMIN_OAUTH_POST_LOGOUT_REDIRECT_URI=https://admin.supermeapp.com/
ADMIN_FE_FORGOT_PASSWORD_URL=https://admin.supermeapp.com/forgot-password
ADMIN_WRITES_ENABLED=false
