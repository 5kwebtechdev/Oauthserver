# ---- SuperMeAdmin panel (admin.supermeapp.com) - appended to the SAME env file, same
# process, same restart as everything above. Leave ADMIN_OAUTH_CLIENT_ID unset to keep the
# admin client/login page disabled entirely; nothing above this line is affected either way.
DB_ADMIN_URL="jdbc:mysql://127.0.0.1:3306/mindfullAdmin?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8"
DB_ADMIN_USERNAME=CHANGE_ME
DB_ADMIN_PASSWORD="CHANGE_ME"
ADMIN_OAUTH_CLIENT_ID=supermeadmin-web
ADMIN_OAUTH_REDIRECT_URIS=https://admin.supermeapp.com/callback
ADMIN_OAUTH_POST_LOGOUT_REDIRECT_URI=https://admin.supermeapp.com/
