# Copy to .env (gitignored) and fill in real values. Run via ./run-dev.sh.

DB_PRIMARY_URL=jdbc:mysql://<host>:3306/
DB_PRIMARY_USERNAME=root
DB_PRIMARY_PASSWORD=

# This service's own copy of auth-server's public key (see ARCHITECTURE.md section 10) -
# not a JWKS URL, no network call made to verify a token's signature.
RESOURCE_SERVER_JWT_PUBLIC_KEY_PATH=/path/to/resource-server/keys/public_key_*.pem
AUTH_SERVER_ISSUER=http://localhost:9000
RESOURCE_SERVER_AUDIENCE=pkce-resource-server
FE_ORIGIN=http://localhost:4200
