<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ always reserves an animated-icon slot in the system splash.
    A transparent drawable suppresses that icon without changing the launcher
    icon that users see on their home screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="1dp"
        android:height="1dp" />
    <solid android:color="@android:color/transparent" />
</shape>
