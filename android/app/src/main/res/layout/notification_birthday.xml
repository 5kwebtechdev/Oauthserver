<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/birthday_card">
    <TextView android:id="@+id/birthday_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" android:textStyle="bold" android:textColor="#0F172A" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/birthday_body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="14sp" android:textColor="#595568" android:maxLines="5" android:ellipsize="end" />
    <TextView android:id="@+id/birthday_cta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="10dp" android:paddingBottom="8dp" android:gravity="center" android:text="See What's Inside"
        android:textColor="#D97706" android:textSize="16sp" android:textStyle="bold" />
</LinearLayout>
