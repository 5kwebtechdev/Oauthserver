{
  "name": "super-me",
  "version": "0.0.2",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "capacitor:copy:after": "node scripts/optimize-android-assets.mjs",
    "android:optimize-assets": "node scripts/optimize-android-assets.mjs",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:ios": "ng build --configuration production && node scripts/verify-avatar-assets.cjs && cap copy ios",
    "optimize:embedded-svg": "node scripts/optimize-embedded-svg-assets.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:focus": "ng test --ts-config tsconfig.focus-spec.json --include='src/app/core/components/superme-timer/*.spec.ts' --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "build-android": "powershell -ExecutionPolicy Bypass -File ./rebuild-apk.ps1",
    "postinstall": "patch-package"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/google-maps": "^19.2.19",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-firebase/analytics": "^7.5.0",
    "@capacitor-firebase/messaging": "^7.5.0",
    "@capacitor-mlkit/barcode-scanning": "^7.5.0",
    "@capacitor/android": "7.2.0",
    "@capacitor/app": "7.0.1",
    "@capacitor/app-launcher": "^7.0.4",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/clipboard": "^7.0.3",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/geolocation": "^7.1.7",
    "@capacitor/haptics": "^7.0.1",
    "@capacitor/ios": "7.2.0",
    "@capacitor/keyboard": "7.0.1",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.3",
    "@capacitor/status-bar": "7.0.1",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@ionic/angular": "^8.0.0",
    "@stomp/stompjs": "^7.3.0",
